#credentials for the MongoDB's user who has rights to create databases and users
# DB_SUPERADMIN_USER=   # Local MongoDB: <mongodb_superadmin_user>, Remote MongoDB: provided by sysadmin
# DB_SUPERADMIN_PASSWORD=  # Local MongoDB: <mongodb_superadmin_password>, Remote MongoDB: provided by sysadmin
# DB_HOST=127.0.0.1    # Local MongoDB: localhost, Remote MongoDB: e.g., 213.184.249.125
# DB_PORT=27017              # Local MongoDB: <mongodb_port>, Remote MongoDB: e.g., 60116

#DB_NAME=panasonic           

